# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` gitignore'da.
# Yalnızca `tailor` komutu (LLM adımları) bu değerlere ihtiyaç duyar;
# `validate` ve `--help` anahtarsız çalışır.

# --- Seçenek 1: yerel llm-gateway (varsayılan kullanım) ---------------------
# workspace'teki llm-gateway/ — Antigravity Manager, Docker'da 8045 portunda.
# base_url `/v1` OLMADAN yazılır; Anthropic SDK yolu kendi ekler.
LLM_BASE_URL=http://127.0.0.1:8045
# llm-gateway/.env içindeki AG_API_KEY değeri. AG_WEB_PASSWORD DEĞİL — o sadece
# panel girişi, API o parolayla 401 döner.
LLM_API_KEY=sk-ag-...
# Gateway'in Model Router'ı `claude-opus*` kalıbını claude-opus-4-6-thinking'e
# düşürüyor, sürüm adı burada kalabilir.
LLM_MODEL=claude-opus-5

# --- Seçenek 2: doğrudan Anthropic API -------------------------------------
# Yukarıdaki üç satırı sil, bunu doldur. Kodda hiçbir değişiklik gerekmez.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Yapılandırılmış çıktı stratejisi (nadiren gerekir) ---------------------
# auto (varsayılan): LLM_BASE_URL varsa zorunlu tool-use, yoksa messages.parse.
# Gateway `output_format`'ı yok sayıyor; bir gün desteklerse `parse` yaz.
# LLM_STRUCTURED_MODE=auto
